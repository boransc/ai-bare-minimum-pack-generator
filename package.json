{
  "name": "ai-bare-minimum-pack-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "tailoring-check": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run scripts/tailoring-check.test.ts",
    "email-check": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run scripts/email-check.test.ts",
    "content-check": "python scripts/extract-source.py && vitest run scripts/content-check.test.ts",
    "contamination-check": "python scripts/extract-source.py && python scripts/contamination-check.py"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "next": "16.3.4",
    "nodemailer": "^9.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
